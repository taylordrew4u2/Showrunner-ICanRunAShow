{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force *)",
      "Bash(git push -f:*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force-with-lease *)"
    ]
  }
}
