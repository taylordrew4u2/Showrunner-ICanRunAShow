# ── Server-side env vars (NO VITE_ prefix — never shipped to the browser) ──
# Required — Turso libSQL database. Used by the /api routes via @libsql/client.
# These are read by the server only; the browser talks to the API, not the DB.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token


# Optional — Stripe subscriptions (the Producer plan). Leave these unset and the
# app runs exactly as before, with the plan card saying paid plans aren't open.
# All server-side; card details only ever touch Stripe's own hosted pages.
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
# The recurring Price for the Producer plan (Stripe → Product catalog → the price's ID).
STRIPE_PRICE_ID=price_...
# Signing secret of the webhook endpoint pointed at https://<your domain>/api/stripe-webhook,
# listening for checkout.session.completed and customer.subscription.created/updated/deleted.
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe sends people back to after checkout. Defaults to the URL the request came in on.
APP_URL=https://icanrunashow.com

# Optional — explicitly published website lineups. Leave all three unset to
# disable the feed. Use only the approved canonical source show IDs, never a
# title/date match or an account-wide wildcard. The initial Pins and Needles
# integration uses its four selected source shows.
# Example: ["approved-show-id-1","approved-show-id-2","approved-show-id-3","approved-show-id-4"]
WEBSITE_LINEUPS_SHOW_IDS=
# Separate random tokens of at least 32 characters. Keep these server-side;
# do not use a VITE_ or NEXT_PUBLIC_ prefix. The website receives only the read
# token. Remove the setup token after its one successful, atomic seed.
WEBSITE_LINEUPS_READ_TOKEN=
WEBSITE_LINEUPS_SETUP_TOKEN=
# Setup, payload contract and the plaintext-publication boundary:
# docs/WEBSITE-LINEUPS.md
